OPTIONAL_TOOL_DEPS := \
$(wildcard ../makefile.defs) \
$(wildcard ../makefile.init) \
$(wildcard ../makefile.targets) \


BUILD_ARTIFACT_NAME := Keyu_TC264DA_Open_Source
BUILD_ARTIFACT_EXTENSION := elf
BUILD_ARTIFACT_PREFIX :=
BUILD_ARTIFACT := $(BUILD_ARTIFACT_PREFIX)$(BUILD_ARTIFACT_NAME)$(if $(BUILD_ARTIFACT_EXTENSION),.$(BUILD_ARTIFACT_EXTENSION),)

# 灏嗚繖浜涘伐鍏疯皟鐢ㄧ殑杈撳叆鍜岃緭鍑烘坊鍔犲埌鏋勫缓鍙橀噺 
SECONDARY_SIZE += \
Keyu_TC264DA_Open_Source.siz \


# 鎵�鏈夌洰鏍�
all: main-build

# 涓绘瀯寤虹洰鏍�
main-build: Keyu_TC264DA_Open_Source.elf secondary-outputs

# 宸ュ叿璋冪敤
Keyu_TC264DA_Open_Source.elf: $(OBJS) makefile $(OPTIONAL_TOOL_DEPS) .Keyu_TC264DA_Open_Source.elf.opt
	@echo '姝ｅ湪鏋勫缓鐩爣锛� $@'
	@echo '姝ｅ湪璋冪敤锛� TASKING Linker'
	cctc -f .Keyu_TC264DA_Open_Source.elf.opt
	@echo '宸茬粨鏉熸瀯寤虹洰鏍囷細 $@'
	@echo ' '

.Keyu_TC264DA_Open_Source.elf.opt:
	@argfile .Keyu_TC264DA_Open_Source.elf.opt --lsl-file="../Lcf_Tasking_Tricore_Tc.lsl" -Wl-Oc -Wl-OL -Wl-Ot -Wl-Ox -Wl-Oy -Wl--map-file="Keyu_TC264DA_Open_Source.map" -Wl-mc -Wl-mf -Wl-mi -Wl-mk -Wl-ml -Wl-mm -Wl-md -Wl-mr -Wl-mu --no-warnings= -Wl--error-limit=42 --fp-model=3 -lrt --lsl-core=vtc --exceptions --strict --anachronisms --force-c++ -Ctc26xb -o"Keyu_TC264DA_Open_Source.elf" -Wl-o"Keyu_TC264DA_Open_Source.hex:IHEX" $(OBJS)

.PHONY: .Keyu_TC264DA_Open_Source.elf.opt

Keyu_TC264DA_Open_Source.siz: Keyu_TC264DA_Open_Source.elf makefile $(OPTIONAL_TOOL_DEPS)
	@echo '姝ｅ湪璋冪敤锛� Print Size'
	elfsize  "Keyu_TC264DA_Open_Source.elf"
	@echo '宸茬粨鏉熸瀯寤猴細 $@'
	@echo ' '

# 鍏朵粬鐩爣
clean:
	-$(RM) Keyu_TC264DA_Open_Source.siz Keyu_TC264DA_Open_Source.elf
	-@echo ' '

secondary-outputs: $(SECONDARY_SIZE)

.PHONY: all clean dependents main-build

-include ../makefile.targets
