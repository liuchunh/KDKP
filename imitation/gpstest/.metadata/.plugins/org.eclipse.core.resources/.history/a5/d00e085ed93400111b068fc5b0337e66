#include "ky_all.h"
#include "ky_adc.h"
#include "ky_ips.h"

IfxCpu_syncEvent cpuSyncEvent = 0;

void core0_main(void)
{
    /* 系统初始化（中断、看门狗等） */
    systemInit(KEYU_CPU_CORE_0);
    cpuSyncWait(&cpuSyncEvent, 1);
    uart_debug_init();
    /* 初始化开始 */
    ips_init(IPS_TYPE_200);//屏幕初始化
    icm45686_init();//陀螺仪初始化

    //尽量使用一个数据采集
    timer_init_ms(TIM_0, 10, icm45686_read_acc);
    //timer_init_ms(TIM_1, 10, icm45686_read_gyro);
    //timer_init_ms(TIM_2, 10, icm45686_read_temp);

    /* 初始化结束 */
    IfxCpu_enableInterrupts(); /* 开启全局中断 */

    while(1)
    {
        /* 主循环开始 */
        ips_show_float( 10, 70, gICM45686Data.acc.x, 2, 2);
        ips_show_float( 10, 90, gICM45686Data.acc.y, 2, 2);
        ips_show_float( 10, 110, gICM45686Data.acc.z, 2, 2);

        //ips_show_float( 80, 70, gICM45686Data.gyro.x, 2, 2);
        //ips_show_float( 80, 90, gICM45686Data.gyro.y, 2, 2);
        //ips_show_float( 80, 110, gICM45686Data.gyro.z, 2, 2);

        //ips_show_float( 150, 70, gICM45686Data.temperature, 2, 2);


        /* 主循环结束 */
    }
}

