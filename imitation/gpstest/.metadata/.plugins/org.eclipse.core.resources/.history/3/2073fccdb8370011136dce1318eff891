#include "ky_all.h"
#include "ky_gnss.h"
#include "ky_ips.h"

IfxCpu_syncEvent cpuSyncEvent = 0;

void core0_main(void)
{
    /* 系统初始化（中断、看门狗等） */
    systemInit(KEYU_CPU_CORE_0);
    cpuSyncWait(&cpuSyncEvent, 1);
    uart_debug_init();
    /* 初始化开始 */

    // 初始化IPS200屏幕
    ips_init(IPS_TYPE_200);
    ips_clear(BLACK);
    ips_show_string(10, 5, "GNSS Positioning");
    ips_show_string(10, 25, "Waiting for satellite...");

    // 初始化GNSS模块
    gnss_init();

    /* 初始化结束 */
    IfxCpu_enableInterrupts(); /* 开启全局中断 */

    printf("GNSS定位模块例程 - 等待卫星定位...\r\n");

    while(1)
    {
        /* 主循环开始 */
        // 处理GNSS数据
        if(gnss_process() == 1)
        {
            // 定位有效，在屏幕上显示定位信息
            ips_set_color(WHITE, BLACK);

            // 显示标题和状态
            ips_show_string(10, 5, "GNSS Positioning");
            ips_show_string(10, 25, "Status: Valid");

            // 显示卫星数量
            ips_show_string(10, 50, "Satellites:");
            ips_show_u_int(90, 50, GnssData.satellites, 2);

            // 显示纬度
            ips_show_string(10, 75, "Latitude:");
            ips_show_float(75, 75, GnssData.latitude, 9, 6);

            // 显示经度
            ips_show_string(10, 100, "Longitude:");
            ips_show_float(75, 100, GnssData.longitude, 9, 6);

            // 显示海拔
            ips_show_string(10, 125, "Altitude:");
            ips_show_float(70, 125, GnssData.altitude, 5, 1);
            ips_show_string(130, 125, "m");

            // 显示速度
            ips_show_string(10, 150, "Speed:");
            ips_show_float(60, 150, GnssData.speed, 4, 1);
            ips_show_string(110, 150, "km/h");

            // 显示航向
            ips_show_string(10, 175, "Course:");
            ips_show_float(65, 175, GnssData.course, 4, 1);
            ips_show_string(115, 175, "deg");

            // 显示精度因子
            ips_show_string(10, 200, "HDOP:");
            ips_show_float(55, 200, GnssData.hdop, 3, 1);

            // 串口打印（降低频率）
            static int print_counter = 0;
            if(print_counter++ >= 5)
            {
                print_counter = 0;
                printf("卫星:%d 纬度:%.6f 经度:%.6f 海拔:%.1fm 速度:%.1fkm/h\r\n",
                       GnssData.satellites, GnssData.latitude, GnssData.longitude,
                       GnssData.altitude, GnssData.speed);
            }
        }
        else
        {
            // 定位无效
            ips_show_string(10, 5, "GNSS Positioning");
            ips_show_string(10, 25, "Status: Searching...");
            ips_show_string(10, 50, "Waiting for satellites");
            ips_show_string(10, 75, "Please wait...");

            static int dot_count = 0;
            ips_show_string(10 + dot_count * 10, 100, ".");
            dot_count = (dot_count + 1) % 20;
        }

        delay_ms(200);
        /* 主循环结束 */
    }
}
