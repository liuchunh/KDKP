/*********************************************************************************************************************
 * 文件名称: cpu0_main.c
 * 功能描述: 编码器 + 电机 测试程序
 ********************************************************************************************************************/

#include "zf_common_headfile.h"
#include "code/encoder.h"
#include "code/motor.h"

#pragma section all "cpu0_dsram"

/* ISR 与主循环通信用变量 */
volatile uint8 g_imu_tick   = 0;
volatile uint8 g_debug_tick = 0;

int core0_main(void)
{
    clock_init();
    debug_init();

    /* 电机初始化 */
    motor1_init();
    motor2_init();
    motor1_stop();
    motor2_stop();

    /* 编码器初始化 */
    encoder1_init();
    encoder2_init();

    /* 等待多核同步 */
    cpu_wait_event_ready();

    /* 打印使用说明 */
    uart_write_string(DEBUG_UART_INDEX, "\r\n==== Motor + Encoder Test ====\r\n");
    uart_write_string(DEBUG_UART_INDEX, "+ = +100  - = -100  s = stop\r\n\r\n");

    int16 duty = 0;
    uint32 tick = 0;
    uint8 rx_buf[32];
    char buf[128];

    while (1)
    {
        /* 串口接收 */
        uint32 len = debug_read_ring_buffer(rx_buf, sizeof(rx_buf));
        for (uint32 i = 0; i < len; i++)
        {
            uint8 ch = rx_buf[i];
            if (ch == '+' || ch == '=')
            {
                duty += 100;
                if (duty > 10000) duty = 10000;
            }
            else if (ch == '-' || ch == '_')
            {
                duty -= 100;
                if (duty < -10000) duty = -10000;
            }
            else if (ch == 's' || ch == 'S')
            {
                duty = 0;
            }

            motor1_set_duty(duty);
            motor2_set_duty(duty);

            sprintf(buf, "Duty=%d\r\n", (int)duty);
            uart_write_string(DEBUG_UART_INDEX, buf);
        }

        /* 每100ms读取编码器 */
        system_delay_ms(100);
        encoder1_update();
        encoder2_update();

        tick++;
        /* 每500ms打印一次编码器数据 */
        if (tick % 5 == 0)
        {
            int16 spd1 = encoder1_get_speed();
            int16 spd2 = encoder2_get_speed();
            float rpm1 = encoder1_get_rpm();
            float rpm2 = encoder2_get_rpm();

            sprintf(buf, "D=%d M1:spd=%d rpm=%.1f M2:spd=%d rpm=%.1f\r\n",
                    (int)(duty < 0 ? -duty : duty),
                    (int)(spd1 < 0 ? -spd1 : spd1), rpm1,
                    (int)(spd2 < 0 ? -spd2 : spd2), rpm2);
            uart_write_string(DEBUG_UART_INDEX, buf);
        }
    }
}
